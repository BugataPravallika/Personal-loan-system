# Copy to .env and set for production builds (Vercel/Netlify), pointing at your deployed backend.
# Leave unset for local dev — Vite proxies /api to localhost:8000 automatically.
VITE_API_BASE_URL=https://your-backend-url.onrender.com/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
